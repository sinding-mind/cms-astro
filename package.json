{
  "name": "@sindingmind/cms-astro",
  "version": "0.1.0",
  "description": "The open Astro integration of the Sinding Mind CMS: field definitions, Zod schemas, content collections and click-to-edit preview markers that leave no trace in a production build.",
  "license": "MIT",
  "author": "Sinding Mind ApS",
  "homepage": "https://github.com/sinding-mind/cms-astro#readme",
  "bugs": {
    "url": "https://github.com/sinding-mind/cms-astro/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinding-mind/cms-astro.git"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "withastro",
    "cms",
    "content-collections",
    "yaml",
    "zod"
  ],
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./fields": {
      "types": "./dist/fields.d.ts",
      "default": "./dist/fields.js"
    },
    "./attrs": {
      "types": "./dist/attrs.d.ts",
      "default": "./dist/attrs.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "default": "./dist/content.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "prepack": "npm run build",
    "test": "npm run build && node --test --test-concurrency=1 \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "astro": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "astro": "7.4.5",
    "rolldown": "1.2.16",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
